{
  "name": "nextjs-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "build": "NODE_OPTIONS=--no-deprecation next build",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "storybook": "NODE_OPTIONS=--no-deprecation storybook dev -p 6006",
    "build-storybook": "NODE_OPTIONS=--no-deprecation storybook build",
    "lint": "next lint",
    "format:check": "prettier --check --ignore-path .prettierignore .",
    "format:fix": "prettier --write --ignore-path .prettierignore .",
    "tsc": "npx tsc",
    "tsc-watch": "npx tsc --w",
    "prepare": "husky",
    "add-comp": "pnpm dlx shadcn@latest add && pnpm format:fix",
    "analyze": "NODE_OPTIONS=--no-deprecation ANALYZE=true npm run build"
  },
  "dependencies": {
    "@next/bundle-analyzer": "15.1.2",
    "@portabletext/react": "^3.0.11",
    "@portabletext/types": "^2.0.13",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.0.3",
    "@sanity/image-url": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "embla-carousel-autoplay": "^8.3.0",
    "embla-carousel-react": "^8.3.0",
    "embla-carousel-wheel-gestures": "^8.0.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.325.0",
    "next": "15.1.9",
    "next-sanity": "^9.8.0",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-player": "^2.15.1",
    "react-refractor": "^3.1.1",
    "refractor": "^4.8.1",
    "server-only": "^0.0.1",
    "sonner": "^1.4.3",
    "suspend-react": "^0.1.3",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@storybook/addon-essentials": "^8.4.4",
    "@storybook/addon-interactions": "^8.4.4",
    "@storybook/addon-links": "^8.4.4",
    "@storybook/addon-onboarding": "^8.4.4",
    "@storybook/addon-viewport": "^8.4.4",
    "@storybook/blocks": "^8.4.4",
    "@storybook/nextjs": "^8.4.4",
    "@storybook/preview-api": "^8.4.4",
    "@storybook/react": "^8.4.4",
    "@storybook/test": "^8.4.4",
    "@types/lodash": "^4.17.13",
    "@types/node": "^20",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@types/refractor": "^3.4.1",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "autoprefixer": "^10.0.1",
    "chromatic": "^11.20.1",
    "eslint": "^9",
    "eslint-config-next": "15.1.4",
    "eslint-plugin-storybook": "^0.11.0",
    "husky": "^9.0.10",
    "msw": "^2.7.0",
    "msw-storybook-addon": "^2.0.4",
    "postcss": "^8",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "storybook": "^8.4.4",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.13.2+sha512.88c9c3864450350e65a33587ab801acf946d7c814ed1134da4a924f6df5a2120fd36b46aab68f7cd1d413149112d53c7db3a4136624cfd00ff1846a0c6cef48a",
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.2",
      "@types/react-dom": "19.0.2"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
